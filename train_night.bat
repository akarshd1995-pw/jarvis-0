@echo off
REM Night training run on the RTX 5070
call .venv\Scripts\activate
echo [1/4] generating 1M training examples...
python -m datagen.generate_intents --n 1000000 --out data/intents || exit /b 1
echo [2/4] training tokenizer...
python -m training.tokenizer --data data/intents/train.jsonl --vocab 2048 --out checkpoints/tokenizer.json || exit /b 1
echo [3/4] training model (see checkpoints\train_log.txt)...
python -m training.train --data data/intents --tokenizer checkpoints/tokenizer.json --out checkpoints/intent.pt --steps 40000 > checkpoints/train_log.txt 2>&1
echo [4/4] evaluating...
python -m training.evaluate --split test_iid --errors checkpoints/errors_iid.jsonl > checkpoints/eval_report.txt 2>&1
python -m training.evaluate --split test_ood --errors checkpoints/errors_ood.jsonl >> checkpoints/eval_report.txt 2>&1
type checkpoints\eval_report.txt
